# MIPAAS Backend — Environment Variables
# Copy to .env and fill in your values

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# GCP
GCP_PROJECT_ID=mipaas-dev
GCP_REGION=us-central1

# Cloud Storage
GCS_DATA_BUCKET=mipaas-dev-data
GCS_MODELS_BUCKET=mipaas-models
GCS_SIGNED_URL_EXPIRY_MINUTES=15

# Pub/Sub
PUBSUB_TOPIC_DICOM_UPLOADED=dicom-uploaded
PUBSUB_TOPIC_PREPROCESSING_DONE=preprocessing-done
PUBSUB_TOPIC_INFERENCE_DONE=inference-done
PUBSUB_TOPIC_RESULTS_READY=results-ready

# Firestore
FIRESTORE_COLLECTION_JOBS=jobs
FIRESTORE_COLLECTION_USERS=users

# Redis (Memorystore)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000

# Central Database (PostgreSQL for Docker/Production, SQLite fallback if omitted)
DATABASE_URL=postgresql://mipaas:mipaas_dev_pass@localhost:5432/mipaas_central
# Leave DATABASE_URL unset to use SQLite at <repo>/data/db/mipaas_central.db
DATABASE_AUTO_SEED=true

# Worker
# MIPAAS_DATA_DIR=   # defaults to <repo>/data
# MIPAAS_ML_DIR=     # defaults to <repo>/ml
# MODEL_CACHE_DIR=   # defaults to <data>/model_cache

# Emulators (local dev only)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
