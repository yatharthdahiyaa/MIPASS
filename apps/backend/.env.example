# MIPAAS Backend — Environment Variables
# Copy to .env and fill in your values

# Flask
FLASK_ENV=development
# Signs nothing user-visible by itself, but MFA secrets are encrypted with a key derived
# from it unless MFA_ENCRYPTION_KEY is set. Use a long random value outside development.
SECRET_KEY=change-me-in-production
# Port 8080 is the default. Pick another if something else on this machine owns it,
# and point the frontend at it with NEXT_PUBLIC_API_ORIGIN.
# HOST=0.0.0.0
# PORT=8080
# MAX_REQUEST_BYTES=67108864

# Central database: PostgreSQL only. Start it with
#   docker compose -f infra/database/docker-compose.db.yml up -d
# Tests use a separate database (mipaas_test) and never touch this one.
DATABASE_URL=postgresql://mipaas:mipaas_dev_pass@127.0.0.1:5432/mipaas_central
# MIPAAS_TEST_DATABASE_URL=postgresql://mipaas:mipaas_dev_pass@127.0.0.1:5432/mipaas_test
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Web app address: used for the links in verification, password-reset and alert e-mails.
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# E-mail. Every message is stored in the email_outbox table; the backend decides delivery:
#   outbox   keep it in the table only (read it with: python scripts/manage_users.py outbox)
#   console  outbox + print the text body to the server log
#   smtp     deliver through the SMTP server below
MAIL_BACKEND=outbox
MAIL_FROM=MIPAAS <no-reply@mipaas.local>
# APP_NAME=MIPAAS
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=1

# Two-step verification: Fernet key that encrypts TOTP secrets at rest. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Changing it (or SECRET_KEY, when this is unset) locks out every
# account with two-step verification on until they use a recovery code or are reset.
# MFA_ENCRYPTION_KEY=

# Redis: shared rate limits across workers, and record events for the patient chat (an X-ray
# added, reviewed or deleted; app/services/events.py). Without it, limits are per process and
# the chat isn't told about changes. Local: docker compose -f infra/database/docker-compose.db.yml up -d redis
# REDIS_URL=redis://localhost:6379/0

# Set to 1 only behind a reverse proxy you control, so client IPs come from X-Forwarded-For.
# TRUST_PROXY=0

# Files and models
# MIPAAS_DATA_DIR=   # defaults to <repo>/data
# MIPAAS_ML_DIR=     # defaults to <repo>/ml
# MODEL_CACHE_DIR=   # defaults to <data>/model_cache
# PATIENT_MAX_UPLOAD_BYTES=26214400

# GCP (cloud storage and Pub/Sub paths only)
GCP_PROJECT_ID=mipaas-dev
GCP_REGION=us-central1
GCS_DATA_BUCKET=mipaas-dev-data
GCS_MODELS_BUCKET=mipaas-models
GCS_SIGNED_URL_EXPIRY_MINUTES=15
PUBSUB_TOPIC_DICOM_UPLOADED=dicom-uploaded
PUBSUB_TOPIC_PREPROCESSING_DONE=preprocessing-done
PUBSUB_TOPIC_INFERENCE_DONE=inference-done
PUBSUB_TOPIC_RESULTS_READY=results-ready
# PUBSUB_EMULATOR_HOST=localhost:8085

# AI agents service (apps/agents/server.py). Leave AGENTS_URL empty to run without agents.
# AGENTS_URL=http://127.0.0.1:8100
# Same value as on the agents service; required whenever AGENTS_URL is set outside development.
# AGENTS_SERVICE_KEY=
# Switch individual agents off without a release: report_explainer,consult_brief,report_draft,record_assistant
# AGENTS_DISABLED=
# Who sees patient data when a patient allows AI processing (shown on the consent screen).
# AGENTS_LLM_NOTICE=Groq Inc. (United States), under our data processing agreement
