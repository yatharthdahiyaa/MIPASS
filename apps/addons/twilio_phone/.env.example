# Twilio add-on settings. Copy to ".env" in this folder (git-ignored); real environment variables also work.
# Turn it on in apps/backend/.env with PHONE_BACKEND=twilio (and PHONE_CHANNEL=sms or whatsapp).

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Console -> Verify -> Services. Sends and checks the one-time codes.
TWILIO_VERIFY_SERVICE_SID=

# Text updates (optional; codes work without these). SMS needs one of:
# TWILIO_SMS_FROM=+1...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# WhatsApp (PHONE_CHANNEL=whatsapp) needs:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox sender
