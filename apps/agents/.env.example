# Copy to .env (git-ignored) and fill in. server.py and chat_server.py load it at startup; real environment variables win.
SARVAM_API_KEY=
# Patient chat LLM: groq (GROQ_API_KEY, from console.groq.com, starts with gsk_)
# or xai (XAI_API_KEY, from console.x.ai, starts with xai-).
CHAT_PROVIDER=groq
GROQ_API_KEY=
# xAI's Grok: the chat when CHAT_PROVIDER=xai, and the XAI agent's review of X-ray heat maps.
XAI_API_KEY=
MIPAAS_BACKEND_URL=http://127.0.0.1:8091

# Shared secret between the MIPAAS backend, this server, chat_server.py and mcp_server.py
# (sent as X-Agents-Key). Without it this server only accepts calls from this machine.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTS_SERVICE_KEY=
# Model the care agents (report_explainer, consult_brief, report_draft) use for wording:
# groq | xai | off. Defaults to CHAT_PROVIDER. With "off" they answer from rules only.
# AGENT_LLM_PROVIDER=
# AGENT_LLM_MODEL=
