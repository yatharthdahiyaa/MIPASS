# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iam_rbac?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
COOKIE_SECURE=false

# MFA Configuration
MFA_APP_NAME="AWS Console IAM"
