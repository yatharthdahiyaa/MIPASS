# Copy to infra/deploy/.env and fill in every value. Never commit the real file.

# Public host name (no scheme). Must point at this server before the first start.
MIPAAS_DOMAIN=health.example.org

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this safe and never change it: it decrypts the two-step secret of every account.
MFA_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_hex(24))"   (hex is safe inside a connection URL)
POSTGRES_PASSWORD=

# Outgoing e-mail (verification, password reset, alerts)
MAIL_FROM=MIPAAS <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# API worker processes. Each loads its own copy of the imaging model: budget about 1.5 GB each.
WEB_CONCURRENCY=2
# Folder on this host with trained model checkpoints (mounted read-only at /ml).
# MIPAAS_ML_HOST_DIR=/srv/mipaas/ml

# AI agents (optional). Start the stack with --profile agents to run the service.
# AGENTS_URL=http://agents:8100
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGENTS_SERVICE_KEY=
# Model the agents may use for wording, only for patients who allowed it: groq | xai | off (default off).
# Needs a data processing agreement with that provider first.
# AGENT_LLM_PROVIDER=off
# GROQ_API_KEY=
# XAI_API_KEY=
# Shown to patients on the consent screen: who would see their data.
# AGENTS_LLM_NOTICE=
