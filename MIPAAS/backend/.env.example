# MIPAAS Backend — Environment Variables
# Copy to .env and fill in your values

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# GCP
GCP_PROJECT_ID=mipaas-dev
GCP_REGION=us-central1

# Cloud Storage
GCS_DATA_BUCKET=mipaas-dev-data
GCS_MODELS_BUCKET=mipaas-models
GCS_SIGNED_URL_EXPIRY_MINUTES=15

# Pub/Sub
PUBSUB_TOPIC_DICOM_UPLOADED=dicom-uploaded
PUBSUB_TOPIC_PREPROCESSING_DONE=preprocessing-done
PUBSUB_TOPIC_INFERENCE_DONE=inference-done
PUBSUB_TOPIC_RESULTS_READY=results-ready

# Firestore
FIRESTORE_COLLECTION_JOBS=jobs
FIRESTORE_COLLECTION_USERS=users

# Redis (Memorystore)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000

# Worker
MODEL_CACHE_DIR=/tmp/model_cache

# Emulators (local dev only)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
